// Postgres everywhere — local dev and production both just point
// DATABASE_URL at a Postgres instance (a free Neon/Railway/Render database,
// or a local Postgres). No other change needed to move between them.
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model CareerEntry {
  id          String   @id @default(cuid())
  name        String
  flag        String
  position    String
  score       Int
  peakRating  Int
  trophies    Int
  seasons     Int
  caps        Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([score])
}
