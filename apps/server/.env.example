# Local dev: point this at a free Postgres (Neon, Railway, Render all offer
# instant free Postgres databases) or a local Postgres instance.
# Production: Render's render.yaml (see repo root) wires this automatically
# from the bundled Postgres service — you don't need to set it by hand there.
DATABASE_URL="postgresql://user:password@localhost:5432/legacyxi"
PORT=8787

# Comma-separated list of origins allowed to call this API. "*" (default)
# allows any origin — fine for a public read-mostly leaderboard, tighten
# this to your deployed frontend's exact origin once you have one.
CORS_ORIGIN=*
